<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
	  <PackageId>Musictopia.$(MSBuildProjectName)</PackageId>
	  <StaticWebAssetBasePath>_content/$(MSBuildProjectName)</StaticWebAssetBasePath>
    <ImplicitUsings>enable</ImplicitUsings>
    <RunPostBuildAppCondition Condition="'$(Configuration)' == 'Release'">true</RunPostBuildAppCondition>
    <FeedType>Public</FeedType>
  </PropertyGroup>
	
  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="BasicBlazorLibrary" Version="10.0.178" />
    <PackageReference Include="Musictopia.FarmSim.Domain" Version="10.0.11" />
    <PackageReference Include="Musictopia.FarmSim.Images.Standard" Version="10.0.12" />
  </ItemGroup>
	<Target Name="ValidateStaticWebAssetContract" BeforeTargets="PrepareForBuild" Condition="Exists('wwwroot')">

		<Error Condition="'$(PackageId)' != 'Musictopia.$(MSBuildProjectName)'" Text="Static web asset contract violation.&#xD;&#xA;PackageId must be Musictopia.$(MSBuildProjectName).&#xD;&#xA;See solution pattern in project: Musictopia.FarmSim.Blazor (first fixed case)." />

		<Error Condition="'$(StaticWebAssetBasePath)' != '_content/$(MSBuildProjectName)'" Text="Static web asset contract violation.&#xD;&#xA;StaticWebAssetBasePath must be _content/$(MSBuildProjectName).&#xD;&#xA;See solution pattern in project: Musictopia.FarmSim.Blazor (first fixed case)." />
	</Target>
  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="C:\VS\OneNet\Apps\CommandLines\PostBuildPackageHandler\bin\Release\net10.0\PostBuildPackageHandler.exe $(ProjectName) $(ProjectDir) $(ProjectFileName) $(TargetDir)" Condition="'$(Configuration)' == 'Release' and '$(RunPostBuildAppCondition)' == 'true'" />
  </Target>
</Project>